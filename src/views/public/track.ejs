<!DOCTYPE html>
<html lang="th">
<head>
  <title>ติดตามเอกสาร</title>
  <%- include('../partials/head') %>
</head>
<body>
<nav class="app-nav">
  <a class="brand" href="/">
    <i class="bi bi-file-earmark-check"></i>
    ฝ่ายเหรัญญิก <span class="badge-rune">รุ่น 21</span>
  </a>
  <div class="nav-links">
    <a href="/"><i class="bi bi-list-ul"></i> รายการทั้งหมด</a>
    <% if (user) { %>
      <a href="/admin/records/<%= recordId %>"><i class="bi bi-pencil"></i> แก้ไข (Admin)</a>
    <% } %>
  </div>
</nav>

<div style="max-width:720px;margin:2rem auto;padding:0 1rem;">
  <div id="pageContent">
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
  </div>
</div>

<div class="toast-container" id="toastContainer"></div>

<script>
const RECORD_ID = '<%= recordId %>';
const STATUS_LABEL = { pending: 'รอดำเนินการ', in_progress: 'กำลังดำเนินการ', completed: 'เสร็จสิ้น', awaiting_docs: 'รอเอกสารเพิ่มเติม' };
const STATUS_ICON  = { pending: 'clock', in_progress: 'arrow-repeat', completed: 'check-lg', awaiting_docs: 'exclamation-triangle' };
let lastUpdated = null;

async function loadData() {
  try {
    const res = await fetch(`/api/records/${RECORD_ID}/public`);
    if (!res.ok) { document.getElementById('pageContent').innerHTML = '<div class="card-flat text-center py-5"><i class="bi bi-exclamation-circle" style="font-size:2rem;color:#dc2626"></i><p class="mt-2">ไม่พบข้อมูลหรือถูกปิดการใช้งาน</p></div>'; return; }
    const { record, stages } = await res.json();
    lastUpdated = record.updated_at;
    render(record, stages);
  } catch {
    document.getElementById('pageContent').innerHTML = '<div class="card-flat text-center py-5">เกิดข้อผิดพลาด กรุณาลองใหม่</div>';
  }
}

function render(record, stages) {
  const completed = stages.filter(s => s.status === 'completed').length;
  const pct = stages.length ? Math.round((completed / stages.length) * 100) : 0;
  const currentStage = stages.find(s => s.id == record.current_stage_id);

  const shareUrl = window.location.href;

  document.getElementById('pageContent').innerHTML = `
    <h2 style="font-size:1.2rem;font-weight:700;color:var(--blue-900);margin-bottom:.25rem">${record.title}</h2>
    ${record.requester_name ? `<p style="color:var(--grey-500);font-size:.85rem;margin-bottom:1rem"><i class="bi bi-person"></i> ${record.requester_name}</p>` : ''}

    ${record.public_note ? `<div class="tl-note mb-3"><i class="bi bi-megaphone"></i> <strong>หมายเหตุ:</strong> ${record.public_note}</div>` : ''}

    <!-- Stats -->
    <div class="stat-strip mb-3" style="border-radius:10px">
      <div class="stat-item">
        <div class="stat-num">${pct}%</div>
        <div class="stat-label">ความคืบหน้า</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">${completed}</div>
        <div class="stat-label">ขั้นตอนที่เสร็จ</div>
      </div>
      <div class="stat-item">
        <div class="stat-num">${stages.length}</div>
        <div class="stat-label">ขั้นตอนทั้งหมด</div>
      </div>
      <div class="stat-item">
        <div class="stat-num" style="font-size:1.1rem">${new Date(record.updated_at).toLocaleDateString('th-TH')}</div>
        <div class="stat-label">อัปเดตล่าสุด</div>
      </div>
    </div>

    <!-- Progress bar -->
    <div class="card-flat mb-3">
      <div class="d-flex justify-content-between align-items-center mb-1">
        <span style="font-size:.85rem;font-weight:600;color:var(--blue-900)">ความคืบหน้าโดยรวม</span>
        <span style="font-size:.85rem;color:var(--grey-500)">${completed} / ${stages.length} ขั้นตอน</span>
      </div>
      <div class="progress" style="height:10px;border-radius:8px">
        <div class="progress-bar bg-success" style="width:${pct}%;border-radius:8px;transition:width .5s"></div>
      </div>
      ${currentStage ? `<p style="font-size:.8rem;color:var(--grey-600);margin-top:.5rem">ขั้นตอนปัจจุบัน: <strong>${currentStage.title}</strong></p>` : ''}
    </div>

    <!-- Timeline -->
    <div class="card-flat mb-3">
      <h5><i class="bi bi-list-check"></i> ขั้นตอนการดำเนินงาน</h5>
      <ul class="timeline">
        ${stages.map((s, i) => `
          <li class="tl-item ${s.id == record.current_stage_id ? 'is-current' : ''}">
            <div class="tl-dot ${s.status} ${s.stage_type === 'inserted' ? 'inserted' : ''}">
              ${s.status === 'completed' ? '<i class="bi bi-check-lg"></i>' : (i + 1)}
            </div>
            <div class="tl-body">
              <div class="tl-title">
                ${s.title}
                ${s.stage_type === 'inserted' ? '<span class="badge-inserted ms-1">เพิ่มเติม</span>' : ''}
                <span class="status-badge status-${s.status} ms-2" style="font-size:.7rem">${STATUS_LABEL[s.status]}</span>
              </div>
              <div class="tl-meta">
                ${s.responsible_person ? `<i class="bi bi-person-fill"></i> ${s.responsible_person}` : ''}
                ${s.action_date ? ` &nbsp;·&nbsp; <i class="bi bi-calendar3"></i> ${new Date(s.action_date).toLocaleDateString('th-TH')}` : ''}
              </div>
              ${s.public_note ? `<div class="tl-note">${s.public_note}</div>` : ''}
            </div>
          </li>
        `).join('')}
      </ul>
    </div>

    <!-- Copy link -->
    <div class="copy-link-bar">
      <i class="bi bi-link-45deg" style="color:var(--blue-600)"></i>
      <span class="link-text">${shareUrl}</span>
      <button class="btn btn-sm btn-outline-primary" onclick="copyLink('${shareUrl}')">
        <i class="bi bi-clipboard"></i> คัดลอกลิงก์
      </button>
    </div>

    <p style="font-size:.72rem;color:var(--grey-500);margin-top:1.5rem;text-align:center">
      <i class="bi bi-shield-check"></i> หน้านี้แสดงเฉพาะข้อมูลสาธารณะ · ข้อมูลส่วนตัวและรายละเอียดการเงินถูกปกป้อง
    </p>
  `;
}

function copyLink(url) {
  navigator.clipboard.writeText(url).then(() => showToast('คัดลอกลิงก์แล้ว', 'success'));
}

function showToast(msg, type='') {
  const t = document.createElement('div');
  t.className = `toast-msg ${type}`;
  t.innerHTML = `<i class="bi bi-${type === 'error' ? 'exclamation-circle' : 'check-circle'}"></i> ${msg}`;
  document.getElementById('toastContainer').appendChild(t);
  setTimeout(() => t.remove(), 3500);
}

// Polling for live updates
async function poll() {
  if (!lastUpdated) return;
  try {
    const res = await fetch(`/api/poll/${RECORD_ID}`);
    if (!res.ok) return;
    const data = await res.json();
    if (data.updated_at !== lastUpdated) loadData();
  } catch {}
}

loadData();
setInterval(poll, 30000);
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
