<!DOCTYPE html>
<html lang="th">
<head>
  <title>เข้าสู่ระบบ — ฝ่ายเหรัญญิก</title>
  <%- include('../partials/head') %>
</head>
<body>
<div class="login-wrap">
  <div class="login-card">
    <div class="login-logo">
      <div class="logo-icon"><i class="bi bi-file-earmark-check-fill"></i></div>
      <h1>ระบบติดตามเอกสาร<br>ฝ่ายเหรัญญิก รุ่น 21</h1>
      <p>เข้าสู่ระบบสำหรับผู้ดูแล</p>
    </div>

    <div id="alertBox" style="display:none" class="alert alert-danger py-2 mb-3" role="alert"></div>

    <div class="mb-3">
      <label class="form-label">ชื่อผู้ใช้</label>
      <input type="text" id="username" class="form-control" placeholder="ชื่อผู้ใช้" autocomplete="username">
    </div>
    <div class="mb-4">
      <label class="form-label">รหัสผ่าน</label>
      <div class="input-group">
        <input type="password" id="password" class="form-control" placeholder="รหัสผ่าน" autocomplete="current-password">
        <button class="btn btn-outline-secondary" type="button" id="togglePwd">
          <i class="bi bi-eye" id="eyeIcon"></i>
        </button>
      </div>
    </div>
    <button id="loginBtn" class="btn btn-primary w-100">
      <span id="loginText">เข้าสู่ระบบ</span>
      <span id="loginSpinner" class="spinner-border spinner-border-sm ms-2" style="display:none"></span>
    </button>

    <div class="mt-3 text-center">
      <a href="/" style="font-size:.8rem;color:var(--grey-500)"><i class="bi bi-eye"></i> ดูหน้าสาธารณะ</a>
    </div>
  </div>
</div>

<script>
document.getElementById('togglePwd').addEventListener('click', () => {
  const pwd = document.getElementById('password');
  const icon = document.getElementById('eyeIcon');
  if (pwd.type === 'password') { pwd.type = 'text'; icon.className = 'bi bi-eye-slash'; }
  else { pwd.type = 'password'; icon.className = 'bi bi-eye'; }
});

async function doLogin() {
  const btn = document.getElementById('loginBtn');
  const alert = document.getElementById('alertBox');
  const username = document.getElementById('username').value.trim();
  const password = document.getElementById('password').value;
  if (!username || !password) { alert.textContent = 'กรุณากรอกชื่อผู้ใช้และรหัสผ่าน'; alert.style.display = 'block'; return; }

  btn.disabled = true;
  document.getElementById('loginSpinner').style.display = 'inline-block';
  document.getElementById('loginText').textContent = 'กำลังเข้าสู่ระบบ...';
  alert.style.display = 'none';

  try {
    const res = await fetch('/api/auth/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ username, password }) });
    const data = await res.json();
    if (res.ok) { window.location.href = '/admin'; }
    else { alert.textContent = data.error || 'เกิดข้อผิดพลาด'; alert.style.display = 'block'; }
  } catch { alert.textContent = 'ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้'; alert.style.display = 'block'; }
  finally { btn.disabled = false; document.getElementById('loginSpinner').style.display = 'none'; document.getElementById('loginText').textContent = 'เข้าสู่ระบบ'; }
}

document.getElementById('loginBtn').addEventListener('click', doLogin);
document.addEventListener('keydown', e => { if (e.key === 'Enter') doLogin(); });
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
