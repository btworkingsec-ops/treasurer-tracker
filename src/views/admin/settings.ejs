<!DOCTYPE html>
<html lang="th">
<head>
  <title>ตั้งค่า — ผู้ดูแลระบบ</title>
  <%- include('../partials/head') %>
</head>
<body>
<nav class="app-nav">
  <a class="brand" href="/admin"><i class="bi bi-file-earmark-check"></i> ฝ่ายเหรัญญิก <span class="badge-rune">รุ่น 21</span></a>
  <div class="nav-links">
    <a href="/admin"><i class="bi bi-arrow-left"></i> กลับ</a>
    <button class="btn btn-sm" style="background:rgba(255,255,255,.1);color:#fff;border:none" onclick="logout()"><i class="bi bi-box-arrow-right"></i> ออก</button>
  </div>
</nav>

<div class="admin-layout">
  <aside class="admin-sidebar">
    <div class="sidebar-section">เมนูหลัก</div>
    <a href="/admin" class="sidebar-link"><i class="bi bi-speedometer2"></i> แดชบอร์ด</a>
    <a href="/admin/settings" class="sidebar-link active"><i class="bi bi-gear"></i> ตั้งค่า</a>
    <a href="/" target="_blank" class="sidebar-link"><i class="bi bi-eye"></i> หน้าสาธารณะ</a>
  </aside>

  <main class="admin-main" style="max-width:680px">
    <h2 style="font-size:1.2rem;font-weight:700;color:var(--blue-900);margin-bottom:1.5rem"><i class="bi bi-gear"></i> ตั้งค่าบัญชี</h2>

    <div id="alertBox"></div>

    <!-- Profile -->
    <div class="card-flat mb-3">
      <h5><i class="bi bi-person-circle"></i> ข้อมูลโปรไฟล์</h5>
      <div class="mb-3">
        <label class="form-label">ชื่อที่แสดง</label>
        <input type="text" id="displayName" class="form-control" placeholder="ชื่อที่แสดงในระบบ">
        <div class="form-text">ชื่อนี้จะแสดงในบันทึกการดำเนินงาน</div>
      </div>
      <div class="mb-3">
        <label class="form-label">ชื่อผู้ใช้</label>
        <input type="text" id="username" class="form-control" disabled style="background:var(--grey-100)">
        <div class="form-text">ไม่สามารถเปลี่ยนชื่อผู้ใช้ได้</div>
      </div>
      <button class="btn btn-primary" onclick="saveProfile()"><i class="bi bi-check-lg"></i> บันทึกชื่อ</button>
    </div>

    <!-- Change Password -->
    <div class="card-flat mb-3">
      <h5><i class="bi bi-lock"></i> เปลี่ยนรหัสผ่าน</h5>
      <div class="mb-3">
        <label class="form-label">รหัสผ่านปัจจุบัน</label>
        <input type="password" id="currentPwd" class="form-control" autocomplete="current-password">
      </div>
      <div class="mb-3">
        <label class="form-label">รหัสผ่านใหม่</label>
        <input type="password" id="newPwd" class="form-control" autocomplete="new-password">
        <div class="form-text">อย่างน้อย 8 ตัวอักษร</div>
      </div>
      <div class="mb-3">
        <label class="form-label">ยืนยันรหัสผ่านใหม่</label>
        <input type="password" id="confirmPwd" class="form-control" autocomplete="new-password">
      </div>
      <button class="btn btn-primary" onclick="changePassword()"><i class="bi bi-lock"></i> เปลี่ยนรหัสผ่าน</button>
    </div>

    <!-- Security Info -->
    <div class="card-flat" style="background:var(--blue-50);border-color:var(--blue-200)">
      <h5 style="color:var(--blue-800)"><i class="bi bi-shield-check"></i> ความปลอดภัย</h5>
      <ul style="font-size:.85rem;color:var(--grey-700);padding-left:1.25rem;margin:0">
        <li>Session หมดอายุหลังจาก 8 ชั่วโมงที่ไม่ได้ใช้งาน</li>
        <li>การเข้าสู่ระบบถูกจำกัดไว้ที่ 10 ครั้ง ต่อ 15 นาที</li>
        <li>ข้อมูลส่วนตัว บัญชีธนาคาร และรายละเอียดการเงินไม่ถูกส่งออกสู่หน้าสาธารณะ</li>
        <li>การเปลี่ยนแปลงทุกอย่างถูกบันทึกใน Audit Log</li>
      </ul>
    </div>
  </main>
</div>

<div class="toast-container" id="toastContainer"></div>

<script>
async function loadMe() {
  try {
    const res = await fetch('/api/auth/me');
    if (!res.ok) { window.location.href = '/login'; return; }
    const me = await res.json();
    document.getElementById('displayName').value = me.display_name;
    document.getElementById('username').value = me.username;
  } catch { window.location.href = '/login'; }
}

async function saveProfile() {
  const display_name = document.getElementById('displayName').value.trim();
  if (!display_name) { showAlert('กรุณากรอกชื่อที่แสดง', 'danger'); return; }
  try {
    const res = await fetch('/api/auth/update-profile', { method: 'PUT', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ display_name }) });
    const data = await res.json();
    if (res.ok) showToast('บันทึกสำเร็จ', 'success');
    else showAlert(data.error || 'เกิดข้อผิดพลาด', 'danger');
  } catch { showAlert('เกิดข้อผิดพลาด', 'danger'); }
}

async function changePassword() {
  const current_password = document.getElementById('currentPwd').value;
  const new_password = document.getElementById('newPwd').value;
  const confirm = document.getElementById('confirmPwd').value;
  if (!current_password || !new_password) { showAlert('กรุณากรอกข้อมูลให้ครบ', 'danger'); return; }
  if (new_password !== confirm) { showAlert('รหัสผ่านใหม่ไม่ตรงกัน', 'danger'); return; }
  if (new_password.length < 8) { showAlert('รหัสผ่านใหม่ต้องมีความยาวอย่างน้อย 8 ตัวอักษร', 'danger'); return; }
  try {
    const res = await fetch('/api/auth/change-password', { method: 'PUT', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ current_password, new_password }) });
    const data = await res.json();
    if (res.ok) { showAlert(data.message, 'success'); setTimeout(() => window.location.href = '/login', 2000); }
    else showAlert(data.error || 'เกิดข้อผิดพลาด', 'danger');
  } catch { showAlert('เกิดข้อผิดพลาด', 'danger'); }
}

function showAlert(msg, type) {
  document.getElementById('alertBox').innerHTML = `<div class="alert alert-${type} py-2">${msg}</div>`;
  setTimeout(() => { document.getElementById('alertBox').innerHTML = ''; }, 5000);
}

function showToast(msg, type='') {
  const t = document.createElement('div'); t.className = `toast-msg ${type}`;
  t.innerHTML = `<i class="bi bi-${type==='error'?'exclamation-circle':'check-circle'}"></i> ${msg}`;
  document.getElementById('toastContainer').appendChild(t);
  setTimeout(() => t.remove(), 4000);
}

async function logout() { await fetch('/api/auth/logout', {method:'POST'}); window.location.href = '/login'; }

loadMe();
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
