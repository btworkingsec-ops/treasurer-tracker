<!DOCTYPE html>
<html lang="th">
<head>
  <title>แดชบอร์ด — ผู้ดูแลระบบ</title>
  <%- include('../partials/head') %>
</head>
<body>
<nav class="app-nav">
  <a class="brand" href="/admin">
    <i class="bi bi-file-earmark-check"></i>
    ฝ่ายเหรัญญิก <span class="badge-rune">รุ่น 21</span>
  </a>
  <div class="nav-links" id="adminName" style="color:var(--blue-200);font-size:.85rem"></div>
  <div class="nav-links">
    <a href="/" target="_blank"><i class="bi bi-eye"></i> หน้าสาธารณะ</a>
    <a href="/admin/settings"><i class="bi bi-gear"></i> ตั้งค่า</a>
    <button class="btn btn-sm" style="background:rgba(255,255,255,.1);color:#fff;border:none" onclick="logout()"><i class="bi bi-box-arrow-right"></i> ออก</button>
  </div>
</nav>

<div class="admin-layout">
  <aside class="admin-sidebar">
    <div class="sidebar-section">เมนูหลัก</div>
    <a href="/admin" class="sidebar-link active"><i class="bi bi-speedometer2"></i> แดชบอร์ด</a>
    <a href="/admin/settings" class="sidebar-link"><i class="bi bi-gear"></i> ตั้งค่า</a>
    <a href="/" target="_blank" class="sidebar-link"><i class="bi bi-eye"></i> หน้าสาธารณะ</a>
  </aside>

  <main class="admin-main">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 style="font-size:1.25rem;font-weight:700;color:var(--blue-900);margin:0">การติดตามทั้งหมด</h2>
      <button class="btn btn-primary" onclick="openCreateModal()">
        <i class="bi bi-plus-lg"></i> สร้างการติดตามใหม่
      </button>
    </div>

    <!-- Summary stats -->
    <div class="row g-3 mb-4" id="statsRow">
      <div class="col-6 col-md-3"><div class="card-flat text-center"><div class="stat-num" id="statTotal" style="font-size:1.75rem;color:var(--blue-800)">—</div><div style="font-size:.8rem;color:var(--grey-500)">ทั้งหมด</div></div></div>
      <div class="col-6 col-md-3"><div class="card-flat text-center"><div class="stat-num" id="statActive" style="font-size:1.75rem;color:var(--blue-600)">—</div><div style="font-size:.8rem;color:var(--grey-500)">กำลังดำเนินการ</div></div></div>
      <div class="col-6 col-md-3"><div class="card-flat text-center"><div class="stat-num" id="statCompleted" style="font-size:1.75rem;color:#15803d">—</div><div style="font-size:.8rem;color:var(--grey-500)">เสร็จสิ้น</div></div></div>
      <div class="col-6 col-md-3"><div class="card-flat text-center"><div class="stat-num" id="statAwaiting" style="font-size:1.75rem;color:#92400e">—</div><div style="font-size:.8rem;color:var(--grey-500)">รอเอกสาร</div></div></div>
    </div>

    <!-- Search -->
    <div class="card-flat mb-3">
      <div class="search-bar">
        <i class="bi bi-search"></i>
        <input type="text" id="searchInput" class="form-control" placeholder="ค้นหา...">
      </div>
    </div>

    <!-- Records table -->
    <div class="card-flat p-0">
      <div id="recordsList">
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
      </div>
    </div>
  </main>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-plus-circle"></i> สร้างการติดตามใหม่</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label">ชื่อการติดตาม <span class="text-danger">*</span></label>
          <input type="text" id="newTitle" class="form-control" placeholder="เช่น การเบิกจ่ายค่าอุปกรณ์กิจกรรมสัปดาห์...">
        </div>
        <div class="mb-3">
          <label class="form-label">ชื่อผู้ยื่นเรื่อง</label>
          <input type="text" id="newRequester" class="form-control" placeholder="เช่น ฝ่ายกิจกรรม รุ่น 21">
        </div>
        <div class="mb-3">
          <label class="form-label">หมายเหตุสาธารณะ</label>
          <textarea id="newPublicNote" class="form-control" rows="2" placeholder="ข้อความที่จะแสดงต่อสมาชิก (ไม่บังคับ)"></textarea>
        </div>
        <div class="mb-3">
          <label class="form-label">รายละเอียดเพิ่มเติม (ภายใน)</label>
          <textarea id="newDescription" class="form-control" rows="2" placeholder="บันทึกภายใน ไม่แสดงต่อสาธารณะ"></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-outline-secondary" data-bs-dismiss="modal">ยกเลิก</button>
        <button class="btn btn-primary" onclick="createRecord()"><i class="bi bi-check-lg"></i> สร้าง</button>
      </div>
    </div>
  </div>
</div>

<div class="toast-container" id="toastContainer"></div>

<script>
const STATUS_LABEL = { pending: 'รอดำเนินการ', in_progress: 'กำลังดำเนินการ', completed: 'เสร็จสิ้น', awaiting_docs: 'รอเอกสารเพิ่มเติม' };
let allRecords = [];

async function loadMe() {
  try {
    const res = await fetch('/api/auth/me');
    if (!res.ok) { window.location.href = '/login'; return; }
    const me = await res.json();
    document.getElementById('adminName').innerHTML = `<span><i class="bi bi-person-circle"></i> ${me.display_name}</span>`;
  } catch { window.location.href = '/login'; }
}

async function loadRecords() {
  try {
    const res = await fetch('/api/records');
    if (!res.ok) { window.location.href = '/login'; return; }
    allRecords = await res.json();
    updateStats();
    renderTable();
  } catch { showToast('ไม่สามารถโหลดข้อมูลได้', 'error'); }
}

function updateStats() {
  document.getElementById('statTotal').textContent = allRecords.length;
  document.getElementById('statActive').textContent = allRecords.filter(r => r.status === 'active').length;
  document.getElementById('statCompleted').textContent = allRecords.filter(r => r.status === 'completed').length;
  document.getElementById('statAwaiting').textContent = allRecords.filter(r => r.status === 'awaiting_docs').length;
}

function renderTable() {
  const q = document.getElementById('searchInput').value.toLowerCase();
  const filtered = q ? allRecords.filter(r => r.title.toLowerCase().includes(q) || (r.requester_name || '').toLowerCase().includes(q)) : allRecords;

  if (!filtered.length) {
    document.getElementById('recordsList').innerHTML = '<div class="text-center py-5" style="color:var(--grey-500)"><i class="bi bi-inbox" style="font-size:2rem"></i><p class="mt-2">ไม่มีรายการ</p></div>';
    return;
  }

  document.getElementById('recordsList').innerHTML = `
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead><tr>
          <th style="padding:1rem 1.25rem">ชื่อการติดตาม</th>
          <th>ผู้ยื่นเรื่อง</th>
          <th>ความคืบหน้า</th>
          <th>อัปเดตล่าสุด</th>
          <th></th>
        </tr></thead>
        <tbody>
          ${filtered.map(r => {
            const total = parseInt(r.total_stages) || 10;
            const done = parseInt(r.completed_stages) || 0;
            const pct = total ? Math.round((done / total) * 100) : 0;
            return `<tr class="record-row" onclick="window.location='/admin/records/${r.id}'">
              <td style="padding:1rem 1.25rem">
                <div class="rec-title">${r.title}</div>
                ${r.public_note ? `<div class="rec-sub">${r.public_note}</div>` : ''}
              </td>
              <td><span style="font-size:.85rem">${r.requester_name || '—'}</span></td>
              <td style="min-width:140px">
                <div style="font-size:.78rem;color:var(--grey-500);margin-bottom:3px">${done} / ${total} ขั้นตอน (${pct}%)</div>
                <div class="progress" style="height:6px;border-radius:4px">
                  <div class="progress-bar ${pct === 100 ? 'bg-success' : 'bg-primary'}" style="width:${pct}%"></div>
                </div>
              </td>
              <td><span class="mono">${new Date(r.updated_at).toLocaleDateString('th-TH')}</span></td>
              <td><button class="btn btn-sm btn-outline-primary" onclick="event.stopPropagation();window.location='/admin/records/${r.id}'"><i class="bi bi-pencil"></i></button></td>
            </tr>`;
          }).join('')}
        </tbody>
      </table>
    </div>`;
}

async function createRecord() {
  const title = document.getElementById('newTitle').value.trim();
  if (!title) { showToast('กรุณากรอกชื่อการติดตาม', 'error'); return; }
  try {
    const res = await fetch('/api/records', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ title, requester_name: document.getElementById('newRequester').value, public_note: document.getElementById('newPublicNote').value, description: document.getElementById('newDescription').value }) });
    const data = await res.json();
    if (res.ok) { bootstrap.Modal.getInstance(document.getElementById('createModal')).hide(); showToast('สร้างการติดตามสำเร็จ', 'success'); setTimeout(() => window.location.href = `/admin/records/${data.id}`, 800); }
    else showToast(data.error || 'เกิดข้อผิดพลาด', 'error');
  } catch { showToast('เกิดข้อผิดพลาด', 'error'); }
}

function openCreateModal() { new bootstrap.Modal(document.getElementById('createModal')).show(); }

function showToast(msg, type='') {
  const t = document.createElement('div'); t.className = `toast-msg ${type}`;
  t.innerHTML = `<i class="bi bi-${type === 'error' ? 'exclamation-circle' : 'check-circle'}"></i> ${msg}`;
  document.getElementById('toastContainer').appendChild(t);
  setTimeout(() => t.remove(), 4000);
}

async function logout() {
  await fetch('/api/auth/logout', { method: 'POST' });
  window.location.href = '/login';
}

document.getElementById('searchInput').addEventListener('input', renderTable);
loadMe();
loadRecords();
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
